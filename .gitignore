# Raw source data (download instructions in data/README.md)
data/raw/*.csv

# Model artifacts: regenerate with `python src/modeling.py`.
# Serialized models (joblib/pickle) execute code when loaded, so they are not committed.
# The small .json metadata files next to them are committed.
outputs/models/*.joblib
outputs/models/*.pkl
outputs/models/*.txt

# Environment
.env
venv/
.venv/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# Jupyter
.ipynb_checkpoints/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Test coverage artifacts
.coverage
htmlcov/

# Quarto rendered HTML output (regenerate from .md source)
docs/*.html
docs/*_files/

# Publication Manager working files
PROJECT_METADATA.md
